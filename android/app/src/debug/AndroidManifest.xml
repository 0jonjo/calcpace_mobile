<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may point at a local Rails server over plain HTTP, and
     accept that server's links the way release accepts calcpace.app's:
     the same paths, so a sign-in against it behaves as in release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- HcSeedActivity writes made-up runs to Health Connect for testing
         the import on an emulator. Debug builds only: a release build never
         asks to write anything. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_ELEVATION_GAINED" />

    <!-- HcProbeActivity lists what each session holds beyond the import's
         totals (laps, route, series). Debug builds only: release asks for
         the five reads the Play Console declares and nothing more. -->
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_POWER" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />

    <application android:usesCleartextTraffic="true">
        <activity
            android:name="app.calcpace.main.MainActivity"
            android:exported="true">
            <!-- A local server can't be verified; debug builds only. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${debugSiteScheme}" />
                <data android:host="${debugSiteHost}" />
                <data android:path="/app_auth/callback" />
                <data android:path="/email_verification" />
                <data android:pathPattern="/.*/email_verification" />
                <data android:pathPrefix="/passwords/" />
                <data android:pathPattern="/.*/passwords/.*" />
            </intent-filter>
        </activity>

        <!-- Seeds Health Connect from adb shell am start; the commands are in
             HcSeedActivity and the README. Launched by adb only. -->
        <activity
            android:name="app.calcpace.health.HcSeedActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Its own launcher icon, so it runs on a phone without adb. Not
             recreated on rotation: that would read everything again and
             drop the answer of an open route dialog. -->
        <activity
            android:name="app.calcpace.health.HcProbeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:label="HC Probe"
            android:taskAffinity="app.calcpace.probe"
            android:theme="@style/Theme.Calcpace">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
