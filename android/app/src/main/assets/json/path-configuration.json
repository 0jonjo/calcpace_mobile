{
  "settings": {},
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "^$",
        "^/$",
        "^/(en|pt\\-BR|es|de|fr|ja|it|nl|ko|sv|pl|no|zh\\-TW|hu|cs|ru)/?$"
      ],
      "properties": {
        "presentation": "replace_root"
      }
    },
    {
      "patterns": [
        "/app_auth/"
      ],
      "properties": {
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "/app_auth/redeem"
      ],
      "properties": {
        "presentation": "replace_root",
        "pull_to_refresh_enabled": false
      }
    }
  ]
}
