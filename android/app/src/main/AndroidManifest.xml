<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Your run is in" notifications, asked for only when the athlete taps
         "turn on" on the site's home card (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Health Connect: runs and walks, read on the phone and sent to the
         athlete's own account. The same five the Play Console declares; no
         WRITE_* in a release build (the debug seed adds its own). -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- WorkManager's foreground-service support: the sync never calls
         setForeground, so the permission and its service stay out (one less
         thing for Play's foreground-service declaration). -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <queries>
        <!-- Health Connect as an app of its own (Android 13 and older). -->
        <package android:name="com.google.android.apps.healthdata" />
        <!-- The browsers, and which of them show Custom Tabs: calcpace.app
             pages meant for the browser are opened in one by name
             (BrowserTab). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".CalcpaceApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Calcpace">

        <!-- No FCM token before the athlete opts in: Push.fetchToken turns
             auto-init on after the tap. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <activity
            android:name=".main.MainActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Calcpace.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The calcpace.app links that open in the app, verified by
                 /.well-known/assetlinks.json on the site: the end of a
                 sign-in in the browser tab (/app_auth/callback, which only
                 this signed app receives) and the email links (verify the
                 address, reset the password). Everything else opens in the
                 browser. Claiming the whole site made Chrome both load a
                 Google or Strava callback and hand it to the app, which gave
                 it back: the callback ran twice and the sign-in failed.
                 IncomingLink decides what each path may do.

                 pathPattern is not a regex: ".*" stops at the first match of
                 the character after it and never backtracks, so
                 ".*/email_verification" would miss "/pt-BR/email_verification".
                 "/.*/…" is one segment (the locale); the bare path is listed apart.
                 The sign-in callback never carries a locale.
                 AppLinksManifestTest holds this list. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="calcpace.app" />
                <data android:path="/app_auth/callback" />
                <data android:path="/email_verification" />
                <data android:pathPattern="/.*/email_verification" />
                <data android:pathPrefix="/passwords/" />
                <data android:pathPattern="/.*/passwords/.*" />
            </intent-filter>

        </activity>

        <!-- Health Connect's "privacy policy" link (Android 13 and older):
             the privacy policy's Health Connect section, in a Custom Tab. -->
        <activity
            android:name=".health.PermissionsRationaleActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- The same, from Android 14's permission usage screen. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".health.PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />

        <!-- A run's share card on its way to the share sheet: content://
             URIs for cacheDir/shared_images/ only, readable by the app
             picked through a one-off grant (ShareImageFiles). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shareimages"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_image_paths" />
        </provider>

        <!-- "Your run is in": data-only FCM messages, drawn by RunNotifications. -->
        <service
            android:name=".push.CalcpaceMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
